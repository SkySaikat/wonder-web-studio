# Production domain. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.wonderwebstudio.com
# Blank: Vercel Production is indexable; local and Preview builds are not.
# Optional explicit override: true for production, false to deliberately close it.
SITE_INDEXABLE=
# Public GA4 identifier. An explicit blank value disables analytics.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-EZ5WDZDQWC
# Search Console verification token, when supplied.
GOOGLE_SITE_VERIFICATION=
# All inquiries and preferred call requests go to info@wonderwebstudio.com.
# Use the exact outgoing SMTP host shown in your Zoho Mail account settings.
# smtppro.zoho.com is the US paid-organization host; account/region settings can differ.
LEAD_EMAIL_PROVIDER=zoho
ZOHO_SMTP_HOST=smtppro.zoho.com
ZOHO_SMTP_PORT=465
ZOHO_SMTP_USER=info@wonderwebstudio.com
# Server-only app password. Set privately; never commit or paste it into chat.
ZOHO_SMTP_PASSWORD=
# Optional existing Resend transport: set LEAD_EMAIL_PROVIDER=resend to use it.
RESEND_API_KEY=
LEAD_FROM_EMAIL=Wonderweb Studio <info@wonderwebstudio.com>
# Turnstile: use matching production site/secret keys for spam protection.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Approved hosted payment links only; never put secret keys in public variables.
STRIPE_PAYMENT_LINK=
PAYPAL_PAYMENT_LINK=
