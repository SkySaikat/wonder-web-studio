# Production domain. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.wonderwebstudio.com
# Blank: Vercel Production is indexable; local and Preview builds are not.
# Optional explicit override: true for production, false to deliberately close it.
SITE_INDEXABLE=
# Account identifiers, not secrets. Leave blank until connected.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
GOOGLE_SITE_VERIFICATION=
# Email provider: use a verified domain in Resend. Do not commit real secrets.
RESEND_API_KEY=
LEAD_FROM_EMAIL=Wonderweb Studio <website@wonderwebstudio.com>
LEAD_TO_EMAIL=info@wonderwebstudio.com
# Turnstile: use matching production site/secret keys for spam protection.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Approved hosted payment links only; never put secret keys in public variables.
STRIPE_PAYMENT_LINK=
PAYPAL_PAYMENT_LINK=
