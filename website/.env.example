# Production domain. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://wonderwebstudio.com
# Keep false on preview. Enable only on the final public production site.
SITE_INDEXABLE=false
# Account identifiers, not secrets. Leave blank until connected.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
GOOGLE_SITE_VERIFICATION=
# Email provider: use a verified domain in Resend. Do not commit real secrets.
RESEND_API_KEY=
LEAD_FROM_EMAIL=Wonderweb Studio <website@wonderwebstudio.com>
LEAD_TO_EMAIL=info@wonderwebstudio.com
# Turnstile: use matching production site/secret keys for spam protection.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional verified booking link; defaults to the inquiry form if empty.
NEXT_PUBLIC_BOOKING_URL=
